{
  "name": "blockbid-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:source && npm run check:abi && tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "preview": "vite preview",
    "check:abi": "node scripts/check-abi.mjs",
    "verify:source": "node scripts/check-source.mjs",
    "test:foundation": "node --experimental-strip-types --test scripts/concurrency.test.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.1.0"
  }
}
